{
  "manifest_version": 3,
  "name": "Senpai Stream — Assistant Publicités",
  "short_name": "Senpai Auto",
  "version": "1.0.0",
  "description": "Automatise le passage des 5 étapes publicitaires sur Senpai Stream avec gestion dynamique des domaines.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Senpai Stream — Automatisation",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/settings/settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "webNavigation",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://senpai-stream.link/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://senpai-stream.link/*"
      ],
      "js": [
        "src/shared/protocol.global.js",
        "src/content/selectors.js",
        "src/content/detector.js",
        "src/content/progression.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
