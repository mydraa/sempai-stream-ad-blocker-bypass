{
  "name": "senpai-stream-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Chrome Manifest V3 extension that automates the 5-step ad gate on Senpai Stream with dynamic domain management.",
  "scripts": {
    "test": "node --test tests/automation.test.js",
    "test:e2e": "node --test tests/e2e.test.js",
    "test:all": "node --test tests/automation.test.js tests/e2e.test.js",
    "mock-site": "node tests/mock-site/server.js",
    "validate:manifest": "node -e \"const fs=require('fs');const m=JSON.parse(fs.readFileSync('manifest.json','utf8'));if(m.manifest_version!==3)process.exit(1);console.log('Manifest V3 valid:',m.name,m.version)\""
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "playwright-core": "^1.65.1"
  }
}
